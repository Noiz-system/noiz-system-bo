HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Valeurs Resend, déjà utilisé par les Cloud Functions BD Market :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<votre clé d'API Resend>
# L'expéditeur doit appartenir à un domaine vérifié chez Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=
SMTP_DEFAULT_REPLY_TO=

# Destinataire des notifications de nouveau ticket de support.
# Vide = aucune notification envoyée (les tickets sont créés normalement).
SUPPORT_NOTIFICATION_EMAIL=
