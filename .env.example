HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# ── Base de données ──────────────────────────────────────────────────────────
# Renseignez SOIT DATABASE_URL (Neon), SOIT les champs discrets (Postgres
# local). Si DATABASE_URL est présente, elle l'emporte : `pg` écrase les champs
# discrets avec ce qu'elle contient. Un DATABASE_URL oublié en local pointe donc
# silencieusement vers la base distante.
DATABASE_CLIENT=postgres

# ▸ Développement — Postgres de la machine. Laissez DATABASE_URL vide.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=noiz-system-bo
DATABASE_USERNAME=
DATABASE_PASSWORD=
# Depuis un conteneur, `localhost` désigne le conteneur lui-même : pour joindre
# le Postgres de l'hôte, utilisez DATABASE_HOST=host.docker.internal
# (le service compose déclare déjà l'alias nécessaire).

# ▸ Production — Neon. Collez l'URL telle quelle depuis la console :
#   DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# TLS. Par défaut : activé dès que DATABASE_URL est renseignée, désactivé sinon
# — ce qui couvre Neon comme le Postgres local sans rien toucher ici.
# Ne renseignez cette variable que pour forcer un cas particulier.
#   DATABASE_SSL=true   → force TLS (URL sans `sslmode`, Postgres local en TLS)
#   DATABASE_SSL=false  → force l'absence de TLS
# Un `sslmode=` présent dans l'URL a le dernier mot, quelle que soit la valeur
# ci-dessous : `require` (défaut Neon, vérifié), `no-verify`, `disable`.
# Neon utilise une autorité publique : aucun certificat à installer.
#DATABASE_SSL=
#DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Neon suspend le compute au repos et ferme les connexions inactives ; garder
# un minimum ouvert provoque des erreurs au réveil. Mettez 0 en production.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_SCHEMA=public

# ── E-mail (SMTP) ────────────────────────────────────────────────────────────
# Valeurs Resend, déjà utilisé par les Cloud Functions BD Market :
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_USERNAME=resend
#   SMTP_PASSWORD=<votre clé d'API Resend>
# L'expéditeur doit appartenir à un domaine vérifié chez Resend.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=
SMTP_DEFAULT_REPLY_TO=

# Destinataire des notifications de nouveau ticket de support.
# Vide = aucune notification envoyée (les tickets sont créés normalement).
SUPPORT_NOTIFICATION_EMAIL=
